{
  "name": "youtube-queue-persist",
  "description": "Save and restore YouTube's native queue in Firefox.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
